{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private authenticated account record linking one verified Firebase Auth user and mobile number to multiple independent VIBE profiles.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "phoneCountryCode": { "type": "string", "description": "Dialing code defaulting to +91" },
        "phoneNumber": { "type": "string", "description": "Mobile number digits" },
        "phoneVerified": { "type": "boolean", "description": "Whether phone OTP verification completed" },
        "activeProfileId": { "type": "string", "description": "Last active VIBE profile ID" },
        "profileCount": { "type": "integer", "description": "Active profile count for abuse rate-limiting" },
        "isDarkMode": { "type": "boolean", "description": "Preferred theme mode" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "phoneCountryCode", "phoneNumber", "phoneVerified", "profileCount", "createdAt", "updatedAt"]
    },
    "VibeProfile": {
      "title": "VibeProfile",
      "description": "Independent VIBE social profile belonging to an ownerUid with its own handle, bio, mood, theme, and stats.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "avatarImage": { "type": "string" },
        "avatarEmoji": { "type": "string" },
        "cardTheme": { "type": "string", "enum": ["electric_purple", "cyber_cyan", "neon_rose", "solar_gold", "obsidian_glass"] },
        "moodStatus": { "type": "string" },
        "moodEmoji": { "type": "string" },
        "activityStatus": { "type": "string" },
        "anonymousDiscovery": { "type": "boolean" },
        "isDeactivated": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "username", "displayName", "cardTheme", "anonymousDiscovery", "isDeactivated", "isOnline", "followersCount", "followingCount", "postsCount", "streakDays", "createdAt", "updatedAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Social feed post or short-video reel authored by a VIBE profile.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "profileId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorDisplayName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorCardTheme": { "type": "string" },
        "caption": { "type": "string" },
        "hashtags": { "type": "array", "description": "Bounded up to 10 hashtags" },
        "mediaType": { "type": "string", "enum": ["photo", "video", "reel", "text"] },
        "mediaData": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public", "close_friends"] },
        "isReel": { "type": "boolean" },
        "audioTrack": { "type": "string" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "profileId", "authorUsername", "authorDisplayName", "caption", "mediaType", "visibility", "isReel", "likesCount", "commentsCount", "sharesCount", "createdAt", "updatedAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Profile-scoped like record on a post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "profileId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "ownerUid", "profileId", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment authored by a VIBE profile on a post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "profileId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "ownerUid", "profileId", "authorUsername", "text", "createdAt"]
    },
    "ProfileCredential": {
      "title": "ProfileCredential",
      "description": "Owner-only salted PBKDF2 password hash, recovery phone, and session logout state for an individual VIBE profile.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "profileId": { "type": "string" },
        "username": { "type": "string" },
        "passwordHash": { "type": "string" },
        "passwordSalt": { "type": "string" },
        "recoveryPhoneE164": { "type": "string" },
        "isLoggedOut": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "profileId", "username", "passwordHash", "passwordSalt", "isLoggedOut", "createdAt", "updatedAt"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Atomic unique username registry preventing duplicate handles across VIBE.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "profileId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "profileId", "ownerUid", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour disappearing story item and media reference authored by a VIBE profile.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "profileId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorDisplayName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "caption": { "type": "string" },
        "mediaData": { "type": "string" },
        "mediaRef": { "type": "string" },
        "sourcePostId": { "type": "string" },
        "bgTheme": { "type": "string" },
        "audience": { "type": "string", "enum": ["all", "close_friends"] },
        "expiresAtMillis": { "type": "integer" },
        "viewsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "profileId", "authorUsername", "authorDisplayName", "audience", "expiresAtMillis", "viewsCount", "createdAt", "updatedAt"]
    },
    "FollowRelation": {
      "title": "FollowRelation",
      "description": "Directed follow and Close Friends relationship between two VIBE profiles.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "targetOwnerUid": { "type": "string" },
        "followerProfileId": { "type": "string" },
        "targetProfileId": { "type": "string" },
        "targetUsername": { "type": "string" },
        "targetDisplayName": { "type": "string" },
        "isCloseFriend": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "targetOwnerUid", "followerProfileId", "targetProfileId", "isCloseFriend", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private or group real-time chat conversation with themes, streaks, and disappearing message settings.",
      "type": "object",
      "properties": {
        "createdByUid": { "type": "string" },
        "participantUids": { "type": "array" },
        "participantProfileIds": { "type": "array" },
        "participantNames": { "type": "object" },
        "isGroup": { "type": "boolean" },
        "groupName": { "type": "string" },
        "chatTheme": { "type": "string", "enum": ["midnight_purple", "neon_cyan", "velvet_rose", "emerald_matrix"] },
        "disappearingSeconds": { "type": "integer" },
        "lastMessage": { "type": "string" },
        "lastMessageSenderProfileId": { "type": "string" },
        "typingProfileIds": { "type": "array" },
        "streakCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["createdByUid", "participantUids", "participantProfileIds", "isGroup", "chatTheme", "disappearingSeconds", "streakCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time message inside a conversation supporting text, media, voice notes, replies, forwarding, reactions, and read receipts.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "participantUids": { "type": "array" },
        "senderUid": { "type": "string" },
        "senderProfileId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["text", "image", "video", "voice", "call_event", "post_share"] },
        "mediaData": { "type": "string" },
        "voiceDurationSec": { "type": "integer" },
        "replyToMessageId": { "type": "string" },
        "replyToPreview": { "type": "string" },
        "forwardedFrom": { "type": "string" },
        "reactions": { "type": "object" },
        "readByProfileIds": { "type": "array" },
        "expiresAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "participantUids", "senderUid", "senderProfileId", "senderName", "text", "mediaType", "expiresAtMillis", "createdAt", "updatedAt"]
    },
    "AudioRoom": {
      "title": "AudioRoom",
      "description": "Live VIBE audio hangout room with speakers, raised hands, and reactions.",
      "type": "object",
      "properties": {
        "hostUid": { "type": "string" },
        "hostProfileId": { "type": "string" },
        "hostUsername": { "type": "string" },
        "title": { "type": "string" },
        "topicTag": { "type": "string" },
        "speakerNames": { "type": "array" },
        "raisedHands": { "type": "array" },
        "listenerCount": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "latestReaction": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostUid", "hostProfileId", "hostUsername", "title", "topicTag", "listenerCount", "isActive", "createdAt", "updatedAt"]
    },
    "ProfileNotification": {
      "title": "ProfileNotification",
      "description": "Profile-isolated activity notification.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorProfileId": { "type": "string" },
        "actorUsername": { "type": "string" },
        "targetOwnerUid": { "type": "string" },
        "targetProfileId": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "comment", "follow", "mention", "streak", "room"] },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorProfileId", "actorUsername", "targetOwnerUid", "targetProfileId", "type", "message", "isRead", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private authenticated account and mobile number record"
    },
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/VibeProfile" },
      "description": "Independent VIBE social profiles owned by a verified user"
    },
    "/profile_credentials/{profileId}": {
      "schema": { "$ref": "#/entities/ProfileCredential" },
      "description": "Owner-isolated password hash and individual session state per profile"
    },
    "/usernames/{usernameId}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Atomic unique username reservation index"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Social feed posts and short-video reels"
    },
    "/posts/{postId}/likes/{likeId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Post likes by profile"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Post comments by profile"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour disappearing stories"
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowRelation" },
      "description": "Follow and Close Friends relations between VIBE profiles"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Private and group real-time chat conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Real-time messages inside a conversation"
    },
    "/audio_rooms/{roomId}": {
      "schema": { "$ref": "#/entities/AudioRoom" },
      "description": "Live VIBE audio hangout rooms"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/ProfileNotification" },
      "description": "Profile-isolated notifications"
    }
  }
}
